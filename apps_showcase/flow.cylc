#!jinja2
[meta]
    description = """
        Showcase of interesting apps.
    """

# At present this only works if the workflow is run on the user's
# desktop, i.e. --host=localhost.
[scheduler]
    [[events]]
        # stall handlers = ssh {{ROSE_ORIG_HOST}} gnome-message stall

[scheduling]
    [[graph]]
        R1 = gnome_message
        R1 = """
            random:fail? => random_failure_msg
            random? => continue
            continue => continue_msg
        """


[runtime]
    [[gnome_message]]
        platform = $ROSE_ORIG_HOST
        script = gnome-message "Hello World" "face-smile"; exit 1
        err-script = gnome-message "Task Failed" "dialog-warning"
        [[[meta]]]
            description = """
                Send a message to Gnome.

                Probably only works on --host=localhost.

                Hint - list of icons...

                find /usr/share/icons/* -name "*.png"
            """

    [[GMESSAGES]]
        platform = $ROSE_ORIG_HOST
        script = gnome-message

    [[random_failure_msg]]
        inherit = GMESSAGES
        [[[environment]]]
            N_MSG = "Random Task Failed"
            N_ICON = "dialog-warning"

    [[random]]
        script = exit $((RANDOM % 2))

    [[continue]]

    [[continue_msg]]
        inherit = GMESSAGES
        [[[environment]]]
            N_MSG = "Workflow Succeeded"
            N_ICON = "checkbox-checked"
