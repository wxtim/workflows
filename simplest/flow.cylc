[meta]
    title = "Simplest Workfløw"
    description = """
    Should give you just enough to get going
    """

[scheduler]
    UTC mode = True

[scheduling]
    # initial cycle point is NOT optional
    initial cycle point = 19831213T0600Z

    [[graph]]
        R1 = cold_start
        P1D = task

[runtime]
    [[cold_start]]
        script = """
        """
    [[task]]
        script = """
        """
